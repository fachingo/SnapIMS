-#!/usr/bin/env python3
-"""Build the SnapIMS v0.13.0 per-file integrity manifest."""
-from __future__ import annotations
-
-import hashlib
-import json
-from datetime import UTC, datetime
-from pathlib import Path
-
-ROOT = Path(__file__).resolve().parents[1]
-EXCLUDED_DIRS = {
-    ".venv",
-    ".pytest_cache",
-    "__pycache__",
-    "snapims.egg-info",
-    "build",
-}
-EXCLUDED_FILES = {
-    "MANIFEST_SHA256.json",
-    "PACKAGE_FILE_MANIFEST.sha256",
-    "SHA256SUMS",
-    "SnapIMS-v0.13.0-full-source.zip",
-    "SnapIMS-v0.13.0-full-source.zip.sha256",
-}
-
-
-def digest(path: Path) -> str:
-    value = hashlib.sha256()
-    with path.open("rb") as handle:
-        for block in iter(lambda: handle.read(1024 * 1024), b""):
-            value.update(block)
-    return value.hexdigest()
-
-
-def included(path: Path) -> bool:
-    relative = path.relative_to(ROOT)
-    if any(part in EXCLUDED_DIRS for part in relative.parts):
-        return False
-    if path.name in EXCLUDED_FILES or path.suffix in {".pyc", ".pyo"}:
-        return False
-    return path.is_file()
-
-
-def main() -> None:
-    files = []
-    for path in sorted(ROOT.rglob("*")):
-        if not included(path):
-            continue
-        relative = path.relative_to(ROOT).as_posix()
-        files.append({"path": relative, "bytes": path.stat().st_size, "sha256": digest(path)})
-
-    manifest = {
-        "release": "0.13.0",
-        "generated_at_utc": datetime.now(UTC).isoformat(timespec="seconds"),
-        "hash_algorithm": "SHA-256",
-        "file_count": len(files),
-        "total_bytes": sum(row["bytes"] for row in files),
-        "exclusions": sorted(EXCLUDED_DIRS | EXCLUDED_FILES),
-        "files": files,
-    }
-    (ROOT / "MANIFEST_SHA256.json").write_text(
-        json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8"
-    )
-    (ROOT / "PACKAGE_FILE_MANIFEST.sha256").write_text(
-        "".join(f"{row['sha256']}  {row['path']}\n" for row in files), encoding="utf-8"
-    )
-
-    critical = [
-        ROOT / "install_v0130.sh",
-        ROOT / "dist/snapims-0.13.0-py3-none-any.whl",
-        ROOT / "SnapIMS_Operator_Guide_v0.13.0.pdf",
-        ROOT / "SnapIMS_Operator_Guide_v0.13.0.docx",
-        ROOT / "MANIFEST_SHA256.json",
-        ROOT / "PACKAGE_FILE_MANIFEST.sha256",
-    ]
-    (ROOT / "SHA256SUMS").write_text(
-        "".join(f"{digest(path)}  {path.relative_to(ROOT).as_posix()}\n" for path in critical),
-        encoding="utf-8",
-    )
-    print(json.dumps({"file_count": len(files), "total_bytes": manifest["total_bytes"]}))
-
-
-if __name__ == "__main__":
-    main()
