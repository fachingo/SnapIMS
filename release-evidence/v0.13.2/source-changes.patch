+    )
+    order_by = {
+        "sequence": "sequence ASC,item_id ASC",
+        "confidence": f"{confidence_expression} ASC,sequence ASC",
+        "title": "lower(COALESCE(NULLIF(title,''),suggested_title,'')) ASC,sequence ASC",
+        "price": "COALESCE(price_cents,suggested_price_cents,0) ASC,sequence ASC",
+        "updated": "updated_at DESC,sequence ASC",
+    }.get(str(sort_name or "sequence"), "sequence ASC,item_id ASC")
+    cte = f"WITH editor_rows AS ({base})"
+    with connect(db_file) as connection:
+        total = int(
+            connection.execute(
+                f"{cte} SELECT COUNT(*) FROM editor_rows {outer_where}",
+                (batch_id, *values),
+            ).fetchone()[0]
+        )
+        page_count = max(1, (total + page_size - 1) // page_size)
+        page = min(page, page_count)
+        offset = (page - 1) * page_size
+        rows = connection.execute(
+            f"{cte} SELECT * FROM editor_rows {outer_where} "
+            f"ORDER BY {order_by} LIMIT ? OFFSET ?",
+            (batch_id, *values, page_size, offset),
+        ).fetchall()
+    items = _attach_item_tags(db_file, [_decode_item_row(row) for row in rows])
+    return {
+        "items": items,
+        "page": page,
+        "page_size": page_size,
+        "page_count": page_count,
+        "total": total,
+        "offset": offset,
+        "has_previous": page > 1,
+        "has_next": page < page_count,
+    }
