# Optional. Normally set by the installed launcher.
# SNAPIMS_PROJECT_PATH=/absolute/path/to/SnapIMS
SNAPIMS_DATA_DIR=~/SnapIMS-data
SNAPIMS_HOST=127.0.0.1
SNAPIMS_PORT=8767
SNAPIMS_AUTH_SECRET=
SNAPIMS_ADMIN_USERNAME=admin
SNAPIMS_ADMIN_PASSWORD_HASH=
SNAPIMS_CLOUDFLARED_BIN=cloudflared
CLOUDFLARE_TUNNEL_CONFIG=~/.cloudflared/config.yml
CLOUDFLARE_TUNNEL_NAME=
SNAPIMS_GUACAMOLE_URL=http://127.0.0.1:8080/guacamole
SNAPIMS_GUACAMOLE_PUBLIC_URL=https://remote.canadavhs.ca/guacamole
SNAPIMS_GUACD_HOST=127.0.0.1
SNAPIMS_GUACD_PORT=4822
SNAPIMS_GUACD_SERVICE=guacd
SNAPIMS_TOMCAT_SERVICE=snapims-guacamole-tomcat
SNAPIMS_XRDP_SERVICE=xrdp
SNAPIMS_GUACAMOLE_CONFIG_DIR=/etc/guacamole
SNAPIMS_MANAGE_GUACAMOLE_SERVICES=true
SNAPIMS_OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_LOCATION_ID=gid://shopify/Location/123456789
SHOPIFY_API_VERSION=2026-07
SHOPIFY_DRAFT_ONLY=true
